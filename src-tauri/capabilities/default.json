{
  "identifier": "default",
  "description": "Default capabilities for LTK Manager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "app-update:default",
    "atlas:default",
    "bin:default",
    "game:default",
    "library:default",
    "objects:default",
    "preview:default",
    "settings:default",
    "patcher:default",
    "launcher:default",
    "diagnostics:default",
    "hotkeys:default",
    "desktop:default",
    "integrations:default",
    "links:default",
    "news:default",
    "workshop:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-show",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "clipboard-manager:allow-read-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "process:allow-restart",
    "process:allow-exit",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "deep-link:default"
  ]
}
