# Dependencies
node_modules/

# Only pnpm is supported (see packageManager in package.json)
package-lock.json
yarn.lock

# Build output
dist/

# Permission schemas tauri-build writes on every build
src-tauri/gen/schemas/

# Editor
.vscode/
.idea/
*.sw?
*.iml

# Logs
*.log

# Environment
.env
.env.*
!.env.example

# Signing keys (generated by cargo tauri signer)
~/.tauri/
~

# Rust build artifacts
debug/
target/
**/*.rs.bk
*.pdb

# Paraglide output, compiled from messages/ (see ADR-0018)
src/paraglide/

# AI local settings
.agents/
.claude/
.codex/
.mcp.json
.scratch/

# Windows
nul

# macOS injection host, staged by scripts/build-macos-host.sh
/src-tauri/resources/ltk_patcher_host
