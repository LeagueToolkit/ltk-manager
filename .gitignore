# Dependencies
node_modules/

# Only pnpm is supported (see packageManager in package.json)
package-lock.json
yarn.lock

# Build output
dist/

# Editor
.vscode/
.idea/
*.sw?
*.iml

# Logs
*.log

# Environment
.env
.env.*
!.env.example

# Signing keys (generated by cargo tauri signer)
~/.tauri/
~

# Rust build artifacts
debug/
target/
**/*.rs.bk
*.pdb

# ts-rs default output (real bindings go to src/lib/bindings/)
src-tauri/bindings/
src-tauri/src/lib/bindings/

# Paraglide output, compiled from messages/ (see ADR-0018)
src/paraglide/

# AI local settings
.agents/
.claude/
.codex/
.mcp.json
.scratch/

# Windows
nul

# macOS injection host, staged by scripts/build-macos-host.sh
/src-tauri/resources/ltk_patcher_host
