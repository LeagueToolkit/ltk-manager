{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* ES2022 for `Array.prototype.at`, which the app already calls. The webview
       is Chromium or WebKit, so nothing here has to reach an older runtime. */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    /* The compiled catalog is JS with JSDoc types (ADR-0018) */
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths. No baseUrl: TypeScript 7 removed it, and these targets are
       already relative to this file. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
