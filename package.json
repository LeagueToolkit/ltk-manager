{
  "name": "ltk-manager-ui",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "1.18.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate:messages && tsc && vite build",
    "build:app": "pnpm build && node scripts/upload-source-maps.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "pnpm generate:messages && pnpm typecheck:tsgo",
    "typecheck:tsgo": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:cycles": "oxlint --tsconfig tsconfig.json src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm generate:messages && pnpm run --parallel \"/^(typecheck:tsgo|lint|lint:cycles|format:check)$/\" && pnpm run test",
    "prepare": "husky",
    "dev:logged": "node scripts/dev-logged.mjs",
    "generate:messages": "paraglide-js compile --project ./project.inlang",
    "generate:types": "cargo test --workspace export_bindings --no-fail-fast",
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "generate:meta-schema": "node scripts/generate-meta-schema.mjs"
  },
  "lint-staged": {
    "./Cargo.lock": [
      "node scripts/generate-licenses.mjs --if-available",
      "git add public/third-party-licenses.json"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,json,css,html,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src-tauri/**/*.rs": [
      "cargo fmt --manifest-path src-tauri/Cargo.toml --"
    ],
    "crates/ltk-manager-core/**/*.rs": [
      "cargo fmt --manifest-path crates/ltk-manager-core/Cargo.toml --"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@inlang/paraglide-js": "2.25.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.3",
    "react-zoom-pan-pinch": "^4.0.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "ts-pattern": "^5.9.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/router-plugin": "^1.167.23",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.14.2"
}
